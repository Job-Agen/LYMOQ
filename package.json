{
  "name": "po",
  "private": true,
  "description": "P\u00d4 \u2014 controlled virtual cards sandbox prototype",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:shared": "pnpm --filter @po/shared build",
    "api:dev": "pnpm build:shared && pnpm --filter @po/api dev",
    "mobile:dev": "pnpm build:shared && pnpm --filter @po/mobile start",
    "db:migrate": "pnpm --filter @po/api prisma:migrate",
    "db:seed": "pnpm --filter @po/api prisma:seed",
    "db:reset": "pnpm --filter @po/api prisma:reset",
    "test": "pnpm build:shared && pnpm --filter @po/api test",
    "typecheck": "pnpm build:shared && pnpm -r --parallel typecheck"
  }
}
